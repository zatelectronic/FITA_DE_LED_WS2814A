	(text "3. Data: DIN_1 (J1) -> pixel 1 -> ... -> pixel 5 -> DOUT_5 (to pixel 6, page 03). Frame of 32 bits per pixel, order R G B W."
		(exclude_from_sim no)
		(at 87.376 231.14 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 60 68 74 1)
			)
